# ── Database ────────────────────────────────────────────────────────────────
# The app connects as a NON-superuser role so PostgreSQL Row-Level Security is
# actually enforced. Superusers and table owners bypass RLS, which would silently
# defeat the tenant isolation in PRD §11.4.
DATABASE_URL="postgresql://nownowhr_app:change-me@localhost:5432/nownowhr?schema=public"

# Migrations need owner rights, so they use a separate, more privileged URL.
DIRECT_DATABASE_URL="postgresql://nownowhr_owner:change-me@localhost:5432/nownowhr?schema=public"

# ── Auth (PRD §11.2) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="1h"
JWT_REFRESH_TTL="8h"

# AES-256-GCM key for Tier 1 fields at rest — salary, bank account, RSA PIN,
# NIN, BVN (PRD §11.1, §11.2). Minimum 32 characters; the app refuses to boot in
# production without it. Rotating this requires re-encrypting existing rows.
FIELD_ENCRYPTION_KEY=""

# ── Session policy (PRD §6.1) ───────────────────────────────────────────────
SESSION_ABSOLUTE_HOURS=8
SESSION_IDLE_MINUTES=30
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=30
PASSWORD_RESET_TTL_HOURS=24

# ── Storage — payslips and documents (PRD §11.2) ────────────────────────────
# Any S3-compatible endpoint. Files are stored under company-scoped key prefixes
# and only ever served via short-lived signed URLs.
STORAGE_ENDPOINT="https://fra1.digitaloceanspaces.com"
STORAGE_REGION="fra1"
STORAGE_BUCKET="nownowhr-documents"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_SIGNED_URL_TTL_SECONDS=300

# ── Email (PRD §17 Q2 — still open) ─────────────────────────────────────────
# `console` logs instead of sending, for local development.
MAIL_DRIVER="console"
MAIL_FROM="NowNowHR <no-reply@nownow.digital>"

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
API_PREFIX="hr/api/v1"
# Comma-separated. The Angular dev server runs on 4200.
CORS_ORIGINS="http://localhost:4200"
DEFAULT_TIMEZONE="Africa/Lagos"
